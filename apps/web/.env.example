# Copy to apps/web/.env and replace the values.

# The API origin the browser talks to. In production this is the API's custom
# domain on the same parent domain as the portal, e.g. https://api.foo.com.
VITE_SERVER_URL=http://localhost:5000

# Optional. Railway's private network address for apps/server, used only by SSR
# loaders so the call never leaves the project. Unset locally.
# SERVER_INTERNAL_URL=http://server.railway.internal:5000

# Optional. Defaults to 3000. Railway sets this for you.
# PORT=3000
