# Copy to apps/server/.env and replace the values.

# 32 characters or more. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32-character-secret
BETTER_AUTH_URL=http://localhost:4000

# Comma-separated: the portal (3001) and the staff app (3000) both call this API.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

DATABASE_URL=postgresql://postgres:password@localhost:5432/stay

# The parent domain the session cookie is scoped to, so a server-rendered page
# on foo.com can forward it to api.foo.com. Leave unset locally: everything is
# on localhost, and Railway's *.up.railway.app hostnames cannot be scoped across
# at all. See docs/adr/0001-tanstack-start-for-customer-portal.md.
# COOKIE_DOMAIN=.foo.com

# Optional. Defaults to 4000. Railway sets this for you.
# PORT=4000
