{
  "name": "stay",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "audit": "pnpm audit --audit-level moderate && pnpm audit signatures",
    "build": "turbo run build",
    "check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "ci": "biome ci --no-errors-on-unmatched --files-ignore-unknown=true . && pnpm format:check && pnpm lint:md && pnpm types:check && pnpm test && pnpm build",
    "db:down": "docker compose down postgres",
    "db:generate": "turbo run db:generate -F @stay/db",
    "db:migrate": "turbo run db:migrate -F @stay/db",
    "db:push": "turbo run db:push -F @stay/db",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:studio": "turbo run db:studio -F @stay/db",
    "db:watch": "docker compose up postgres",
    "deps:outdated": "pnpm outdated -r",
    "dev": "turbo run dev",
    "dev:server": "turbo run dev -F server",
    "dev:staff": "turbo run dev -F staff",
    "dev:web": "turbo run dev -F web",
    "docker:build": "docker compose build --pull",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:up": "docker compose up -d --build --pull always",
    "format": "prettier --write \"**/*.{md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{md,yaml,yml}\"",
    "lint:md": "markdownlint \"**/*.md\" --ignore-path .gitignore",
    "lint:md:fix": "markdownlint --fix \"**/*.md\" --ignore-path .gitignore",
    "prepare": "husky || true",
    "test": "vitest run",
    "types:check": "turbo run types:check"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.23.0 <12"
  },
  "dependencies": {
    "@stay/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@stay/config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "turbo": "^2.10.12",
    "vitest": "^4.1.11",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ],
    "*.{md,yaml,yml}": [
      "prettier --check"
    ],
    "*.md": [
      "markdownlint --ignore-path .gitignore"
    ]
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af"
}
